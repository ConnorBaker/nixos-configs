+			ASSERT3U(indbp[i]->db_offset, ==, inoff);
+			ASSERT3U(outdbp[i]->db_offset, ==, outoff);
+			ASSERT3P(indbp[i]->db_data, !=, NULL);
+			ASSERT3P(outdbp[i]->db_data, !=, NULL);
